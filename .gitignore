# =====================================================
# ROS2 colcon 编译产物(必须 ignore)
# =====================================================
build/
install/
log/

# =====================================================
# Python 编译缓存
# =====================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# =====================================================
# macOS 系统垃圾(防止 _* 文件被 commit)
# =====================================================
.DS_Store
.AppleDouble
._*

# =====================================================
# IDE / 编辑器本地配置
# =====================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =====================================================
# 主办方资产包(已部署在 /var/workspace/docker/isaac/scenes/)
# 不应该 commit 到 workspace 的 git 仓库
# =====================================================
# (历史遗留: 之前 demo_ws/ 和 isaacsimassets-dev/ 在这里, 已拆走, 此处只是注释)
# 现在两个官方包都在 scenes/ 下:
#   scenes/X1_assets/       (Mercury X1 资产, 部署进来的)
#   scenes/bobac_assets/    (Bobac / Mercury X1 / Sunray, 部署进来的)
# /var/workspace/docker/isaac/incoming/*.zip 也有原压缩包 (1.9GB), 不入 git

# =====================================================
# 抓取示例的调试输出(grasp_demo_pkg 自动生成)
# =====================================================
grasp_demo_debug/

# =====================================================
# AI 模型权重文件（>50MB，单文件太大不入 git）
# 由 docs/setup/env_setup.md 或比赛包自带安装脚本单独部署
# =====================================================
**/weights/
*.pt
*.pth
*.onnx
*.h5
*.pkl

# =====================================================
# ROS bag / 日志 / 临时文件
# =====================================================
*.bag
*.log
*.tmp
*.bak
core.*

# =====================================================
# Claude Code session 数据（不入库）
# =====================================================
.claude/

# =====================================================
# 比赛提交包 (D-1 阶段用 `bash docs/project/build_submission.sh` 生成)
# =====================================================
双臂-*-预选赛.zip
双臂-*-预选赛.zip.md5

# =====================================================
# systemd --user unit（运行时在 ~/.config/systemd/user/，不入库）
# 安装脚本放在 deploy/ 或 scripts/ 里再 commit
# =====================================================
# (不强 ignore；只作为注释提醒)

# =====================================================
# 黑盒二进制与数据产物（只存在于 Socl 运行时，不入库）
# =====================================================
netclient
bags/
*.mcap
videos/
videos_raw/
*.mp4
frames_*.gv
frames_*.pdf
symlink_install_manifest.txt
