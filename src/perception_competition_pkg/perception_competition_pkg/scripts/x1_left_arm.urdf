<?xml version="1.0"?>
<!--
  Mercury X1 left arm -- 6-DOF URDF for cuRobo IK.

  Joint chain (matches the X1 USD prim path
  ``/World/layout/mercury_x1_final/mercury_x1/link_*``):

      link_body  --  link1_L  --  link3_L  --  link4_L  --  link5_L  --  link6_L  --  tool
       (base)   (j1 yaw)  (j2 pitch)  (j3 elbow)  (j4 wrist)  (j5 wrist)  (j6 wrist)

  Link lengths are placeholder values matching a typical 6-DOF arm
  reach of ~0.55 m; once M1 bakes the real X1 USD, the link lengths
  here should be replaced with the actual ``mercury_x1_final/mercury_x1``
  joint-frame offsets. Register with cuRobo by dropping this file at
  ``$ISAACSIM_PATH/lib/python3.11/site-packages/curobo/content/configs/robot/x1_left_arm.yml``
  and referring to it as ``robot="x1_left_arm.yml"``.

  Joint axes (z-up rotational conventions):

      j1  base yaw          -- rotation about z, full 360 deg
      j2  shoulder pitch    -- rotation about y, [-pi, pi]
      j3  elbow             -- rotation about y, [-pi, pi]
      j4  wrist roll        -- rotation about z, full 360 deg
      j5  wrist pitch       -- rotation about y, [-pi/2, pi/2]
      j6  tool roll         -- rotation about z, full 360 deg

  Frame layout (right-handed, x-forward, y-left, z-up):

      base_link
        | (j1 axis = z, origin = "0 0 0.10")
        link_1
        | (j2 axis = y, origin = "0 0 0.20")
        link_2
        | (j3 axis = y, origin = "0 0 0.18")
        link_3
        | (j4 axis = z, origin = "0 0 0.10")
        link_4
        | (j5 axis = y, origin = "0 0 0.06")
        link_5
        | (j6 axis = z, origin = "0 0 0.04")
        link_6
        | (tool = fixed, origin = "0 0 0.05")
        tool
-->
<robot name="x1_left_arm">
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry><box size="0.10 0.10 0.10"/></geometry>
    </visual>
  </link>

  <link name="link_1">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.10"/>
      <geometry><cylinder length="0.20" radius="0.04"/></geometry>
    </visual>
  </link>

  <link name="link_2">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.09"/>
      <geometry><cylinder length="0.18" radius="0.035"/></geometry>
    </visual>
  </link>

  <link name="link_3">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry><cylinder length="0.10" radius="0.03"/></geometry>
    </visual>
  </link>

  <link name="link_4">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <geometry><cylinder length="0.06" radius="0.025"/></geometry>
    </visual>
  </link>

  <link name="link_5">
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry><cylinder length="0.05" radius="0.02"/></geometry>
    </visual>
  </link>

  <link name="link_6">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry><cylinder length="0.05" radius="0.018"/></geometry>
    </visual>
  </link>

  <link name="tool">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry><box size="0.03 0.05 0.05"/></geometry>
    </visual>
  </link>

  <joint name="arm_left_joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <joint name="arm_left_joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <joint name="arm_left_joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <joint name="arm_left_joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30" velocity="1.0"/>
  </joint>

  <joint name="arm_left_joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="1.0"/>
  </joint>

  <joint name="arm_left_joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="1.0"/>
  </joint>

  <joint name="tool_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
